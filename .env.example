# ---------------------------------------------------------------------------
# CEN 2027 — variáveis de ambiente
# Copie para `.env` e preencha o que for usar. Nada aqui é obrigatório para
# subir a landing page: o servidor sobe com tudo vazio, só desliga os recursos
# que dependem de cada serviço.
# ---------------------------------------------------------------------------

# Porta do Express. Se estiver ocupada, o servidor procura a próxima livre.
PORT=3000

# Assina o cookie de sessão. Gere um valor aleatório longo para produção.
JWT_SECRET=

# MySQL para a tabela `users` (drizzle/schema.ts). Vazio: o site funciona,
# apenas não persiste usuário nenhum.
# Formato: mysql://usuario:senha@host:3306/banco
DATABASE_URL=

# ---------------------------------------------------------------------------
# Loja (Shopify Storefront API)
# Sem estas duas, a seção "Loja" exibe o estado de erro tratado
# ("A loja está em preparação") em vez de quebrar a página.
# ---------------------------------------------------------------------------
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_API_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Herança do Manus — só preencher se for reconectar à plataforma.
# Sem isso, `auth.me` devolve visitante anônimo, que é o comportamento correto
# para um site público.
# ---------------------------------------------------------------------------
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
